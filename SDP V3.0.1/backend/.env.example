# Environment variables for Prisma/MySQL.
#
# Note: backend code does not load dotenv automatically.
# When running Prisma CLI, it will typically read `.env` in this folder.
# For the app itself, ensure this process has DATABASE_URL in its environment.

# Match the MySQL values from `SDP V3.0.1/.env` (defaults shown there):
DATABASE_URL="mysql://root:@localhost:3306/sdp"

# Email Configuration for Password Reset
EMAIL_USER="your-email@gmail.com"
EMAIL_APP_PASSWORD="your-app-password"
FRONTEND_URL="http://localhost:5173"

# JWT Tokens
ACCESS_TOKEN_SECRET="your-access-token-secret"
REFRESH_TOKEN_SECRET="your-refresh-token-secret"
ACCESS_TOKEN_EXPIRES_IN=86400
REFRESH_TOKEN_EXPIRES_IN=604800

